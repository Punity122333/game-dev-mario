{
  "routes": [
    {
      "src": "^/$",
      "status": 307,
      "headers": {
        "Location": "/game/"
      }
    },
    {
      "src": "^/game$",
      "status": 307,
      "headers": {
        "Location": "/game/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/game/index.html"
    }
  ]
}
